# ==================================================
# APPLICATION
# ==================================================
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info

# Multiple origins separated by |
TRUSTED_ORIGINS=http://localhost:3000|http://localhost:5173

# ==================================================
# DATABASE
# ==================================================
DATABASE_URL=mysql://username:password@localhost:3306/devtrack

# ==================================================
# REDIS
# ==================================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB_INDEX=0

# Upstash Redis (optional)
UPSTASH_REDIS_TCP_URL=

# ==================================================
# SMTP
# ==================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="DevTrack <noreply@devtrack.com>"
SMTP_SECURE=false

# ==================================================
# AUTH
# ==================================================
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# ==================================================
# FRONTEND
# ==================================================
FRONTEND_URL=http://localhost:5173

# ==================================================
# NOTION
# ==================================================
NOTION_ENCRYPTION_KEY=replace-with-32-byte-encryption-key